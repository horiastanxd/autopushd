#!/usr/bin/env bash
# autopushd: commit+push la timp toate repo-urile git configurate, cu remote origin.
# --status: scanare read-only (fara commit/pull/push/remote-fix), pt tray/UI.
set -uo pipefail

STATUS_ONLY=0
NO_PULL=0
for arg in "$@"; do
    [ "$arg" = "--status" ] && STATUS_ONLY=1
    [ "$arg" = "--no-pull" ] && NO_PULL=1
done

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/autopushd"
ROOTS_FILE="$CONFIG_DIR/roots.txt"
LOG_FILE="$CONFIG_DIR/autopushd.log"
LOCK_FILE="$CONFIG_DIR/autopushd.lock"

mkdir -p "$CONFIG_DIR"

if [ ! -f "$ROOTS_FILE" ]; then
    cat > "$ROOTS_FILE" <<EOF
# Un director per linie. autopushd scaneaza recursiv fiecare pt repo-uri git cu remote origin.
# Exemplu:
# $HOME/Projects
EOF
    echo "Config gol la $ROOTS_FILE - adauga directoare cu proiectele tale si ruleaza din nou." >&2
    exit 1
fi

log() { echo "$(date -Iseconds) $1" >> "$LOG_FILE"; }

if [ "$STATUS_ONLY" -eq 0 ]; then
    exec 9>"$LOCK_FILE"
    flock -n 9 || { log "already running, skip"; exit 0; }
fi

EXCLUDE_REGEX='/(node_modules|\.venv|venv|target|build|dist|\.next|\.cache)(/|$)'

while IFS= read -r root; do
    root="${root%%#*}"
    root="$(echo -n "$root" | xargs)"
    [ -z "$root" ] && continue
    [ -d "$root" ] || continue
    while IFS= read -r -d '' gitdir; do
        repo="${gitdir%/.git}"
        [[ "$repo" =~ $EXCLUDE_REGEX ]] && continue

        cd "$repo" || continue
        git rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue

        origin_url="$(git remote get-url origin 2>/dev/null)" || continue
        is_https=0
        [[ "$origin_url" =~ ^https://github\.com/ ]] && is_https=1

        if [ "$STATUS_ONLY" -eq 0 ] && [ "$is_https" -eq 1 ] && [[ "$origin_url" =~ ^https://github\.com/(.+)$ ]]; then
            git remote set-url origin "git@github.com:${BASH_REMATCH[1]}"
            log "INFO switched origin to ssh in $repo"
        fi

        branch="$(git symbolic-ref --short -q HEAD)" || continue
        upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)" || upstream=""

        dirty=0
        [ -n "$(git status --porcelain 2>/dev/null)" ] && dirty=1

        if [ "$STATUS_ONLY" -eq 1 ]; then
            if [ -z "$upstream" ]; then
                echo "NOUP|$repo|dirty=$dirty|https=$is_https"
                continue
            fi
            ahead="$(git rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)"
            behind="$(git rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)"
            writable=1
            if [ "$ahead" -gt 0 ]; then
                git push --dry-run origin "HEAD:${upstream#*/}" >/dev/null 2>&1 || writable=0
            fi
            echo "STATUS|$repo|dirty=$dirty|ahead=$ahead|behind=$behind|https=$is_https|writable=$writable"
            continue
        fi

        if [ "$dirty" -eq 1 ]; then
            git add -A
            if ! GIT_AUTHOR_NAME="Autopushd Bot" GIT_AUTHOR_EMAIL="autopushd@local" \
                 GIT_COMMITTER_NAME="Autopushd Bot" GIT_COMMITTER_EMAIL="autopushd@local" \
                 git commit -m "chore(autopushd): $(date '+%Y-%m-%d %H:%M:%S') [skip ci]" >/dev/null 2>&1; then
                log "WARN commit failed in $repo"
                continue
            fi
        fi

        if [ -z "$upstream" ]; then
            log "SKIP no upstream for $repo ($branch)"
            continue
        fi

        if [ "$NO_PULL" -eq 1 ]; then
            log "INFO skip pull (--no-pull) in $repo"
        elif ! git pull --rebase --autostash >/dev/null 2>&1; then
            log "WARN pull --rebase failed in $repo, skip push (rezolva manual conflict)"
            continue
        fi

        ahead="$(git rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)"
        if [ "$ahead" -gt 0 ]; then
            if git push origin "HEAD:${upstream#*/}" >/dev/null 2>&1; then
                log "OK pushed $repo ($branch, $ahead commit(s))"
            else
                log "WARN push failed in $repo (poate fork fara drept de scriere)"
            fi
        fi
    done < <(find "$root" -type d -name .git -print0 2>/dev/null)
done < "$ROOTS_FILE"
